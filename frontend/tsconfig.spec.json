/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    // Pin the source root explicitly: all specs live under src/app today, so TypeScript would
    // otherwise infer './src/app' and warn that the root could shift if a spec is added elsewhere.
    "rootDir": "src",
    "types": [
      "vitest/globals",
      // design-tokens.spec.ts reads styles.scss off disk to check contrast against the real
      // tokens rather than a copy of them. Specs run in Node (jsdom is only the DOM), so fs and
      // path are genuinely available here; nothing in src/app itself may import them.
      "node"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts"
  ]
}
