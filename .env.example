# Copy to .env and fill in. Never commit .env.

# Neon Postgres. Get BOTH endpoints from the Neon console.
# Flyway needs the DIRECT (unpooled) endpoint — Neon's PgBouncer runs in
# transaction mode and breaks Flyway's session advisory lock.
NEON_UNPOOLED_URL=jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/peerdsa?sslmode=require&channelBinding=require
# The running app uses the POOLED endpoint (note the "-pooler" in the host).
NEON_POOLED_URL=jdbc:postgresql://ep-xxxx-pooler.us-east-2.aws.neon.tech/peerdsa?sslmode=require&channelBinding=require
NEON_USER=neondb_owner
NEON_PASSWORD=

# JWT signing key. Must be >= 32 bytes for HS256.
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# Shared secret between Spring Boot and the FastAPI analytics service.
INTERNAL_TOKEN=change-me-too

# Where the FastAPI analytics service listens.
ANALYTICS_BASE_URL=http://localhost:8000

# Piston sandbox that runs the in-app code editor's submissions. Read by the analytics
# service. Defaults to the public instance (rate-limited); point at a self-hosted Piston
# for real usage. See https://github.com/engineer-man/piston for self-hosting.
# PISTON_URL=https://emkc.org/api/v2/piston

# Which calendar a "day" belongs to for streaks and the heatmap. Defaults to UTC.
# Set to your audience's zone, e.g. Asia/Kolkata.
STREAK_ZONE=UTC

# The backend defaults to 8080; override if that port is taken.
# SERVER_PORT=8081
