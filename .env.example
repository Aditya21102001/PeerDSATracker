# Copy to .env and fill in. Never commit .env.

# Neon Postgres. Get BOTH endpoints from the Neon console.
# Flyway needs the DIRECT (unpooled) endpoint — Neon's PgBouncer runs in
# transaction mode and breaks Flyway's session advisory lock.
NEON_UNPOOLED_URL=jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/peerdsa?sslmode=require&channelBinding=require
# The running app uses the POOLED endpoint (note the "-pooler" in the host).
NEON_POOLED_URL=jdbc:postgresql://ep-xxxx-pooler.us-east-2.aws.neon.tech/peerdsa?sslmode=require&channelBinding=require
NEON_USER=neondb_owner
NEON_PASSWORD=

# JWT signing key. Must be >= 32 bytes for HS256.
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# Shared secret between Spring Boot and the FastAPI analytics service.
INTERNAL_TOKEN=change-me-too

# Where the FastAPI analytics service listens.
ANALYTICS_BASE_URL=http://localhost:8000

# Piston sandbox that runs the in-app code editor's submissions. Read by the analytics
# service. The public emkc.org instance is whitelist-only as of 2026-02-15, so run your own:
#   docker run -d --name piston -p 2000:2000 ghcr.io/engineer-man/piston
# then install the language packages you want (via the ppman CLI or the /api/v2/packages
# endpoint). Defaults to that local instance. Self-hosted base ends in /api/v2.
# PISTON_URL=http://localhost:2000/api/v2

# AI study assistant (the chat widget). Get a free key at https://openrouter.ai (Keys ->
# Create Key). Blank disables chat: /api/chat then returns 503 "not configured" and the rest
# of the app is unaffected. OPENROUTER_MODEL must be a real free model id ending in ":free"
# ("openrouter/free" is NOT valid); the free list rotates. Defaults live in application.yml.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Which calendar a "day" belongs to for streaks and the heatmap. Defaults to UTC.
# Set to your audience's zone, e.g. Asia/Kolkata.
STREAK_ZONE=UTC

# The backend defaults to 8080; override if that port is taken.
# SERVER_PORT=8081

# ---------------------------------------------------------------- account recovery
#
# One-time codes by email: sign-in without a password, and the way an account created
# through Google sets its first one.
#
# DEMO MODE returns the code in the HTTP response instead of emailing it, so the whole
# flow works with no mail provider configured. It is a development affordance and nothing
# else: with it on, anyone who asks for a code for your address is handed it. It MUST be
# false in production, and the sign-in screen labels the code loudly while it is on.
OTP_DEMO_MODE=true

# Delivery goes over the provider's HTTP API, never SMTP -- Render, Fly and Heroku all
# block the outbound SMTP ports, so an SMTP mailer works locally and then fails silently
# once deployed.
#
# Brevo's free tier is 300 emails/day: sign up, create an API key (SMTP & API -> API keys),
# and verify a sender address (Senders & IPs). An unverified sender is rejected outright.
# Set `none` to disable delivery entirely; /api/auth/otp/request then answers 503 unless
# demo mode is on.
OTP_EMAIL_PROVIDER=brevo
OTP_EMAIL_API_KEY=
OTP_EMAIL_FROM=
# OTP_EMAIL_FROM_NAME=PeerDSATracker

# Codes per destination address per hour. Counted for unregistered addresses too, so a
# 429 can never be used to test which addresses have accounts.
# OTP_MAX_PER_HOUR=5

# How long after a code sign-in the session may set a password without the old one.
# Deliberately separate from the 15-minute access-token TTL: lengthening how long a
# session lasts must not lengthen how long a password can be rewritten.
# OTP_VERIFIED_WINDOW=PT15M

# The absolute ceiling on one session, from the moment the user authenticated. Refresh
# expiry slides forward on every use, so without this a session that is merely used often
# enough -- or a stolen refresh token -- never expires.
# SESSION_MAX=P90D

# ------------------------------------------------------------------ Google sign-in
#
# Both blank means the feature is not installed: no /oauth2/** endpoints exist and the
# frontend hides the button (it asks GET /api/auth/options rather than guessing).
#
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web
# application). Register BOTH redirect URIs, because the flow must start and finish on the
# same origin:
#   http://localhost:4300/login/oauth2/code/google      (dev, via the ng serve proxy)
#   https://<your-backend>.onrender.com/login/oauth2/code/google   (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# May a Google identity with no account here create one? On, because this tracker's own
# sign-up is already open to anyone with an email address, so refusing a first-time Google
# user would only make the button look broken. Set false where accounts are meant to be
# handed out rather than taken. This does not affect privileges -- see OAUTH_DEFAULT_ROLE.
OAUTH_AUTO_PROVISION=true

# What such an account gets. The application REFUSES TO START if this names a privileged
# role, because the failure is otherwise silent -- the account looks ordinary right up
# until it does something only an admin should.
OAUTH_DEFAULT_ROLE=USER

# Where the OAuth2 callback sends the browser back to, and where reset links point.
# A wrong value here silently sends production users to localhost. Falls back to
# FRONTEND_BASE_URL, then to http://localhost:4300.
# APP_FRONTEND_URL=http://localhost:4300
