@startuml flow-camera-presence-gesture
' Client-side Camera Presence Sentinel & Gesture-Aware Playback Engine
'
' Render: plantuml docs/diagrams/flow-camera-presence-gesture.puml

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor #FDFDFD
  ParticipantBorderColor #5B5BD6
  ArrowColor #59606F
  LifeLineBorderColor #5B5BD6
  LifeLineBackgroundColor #EFF1F6
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C2670A
}

title Smart Camera Presence Sentinel & Gesture Recognition Flow

actor User
participant "VideoHubPage\n(PiP Sentinel)" as Hub
participant "VideoStudyCoachService" as Coach
participant "OpenCvGestureService\n(Vision Engine)" as CV
participant "YouTube Player\n(IFrame / API)" as Player

autonumber

== Initialization ==
User -> Hub: Select & watch video
Hub -> Coach: attachPlayer(iframe, videoId)
Coach -> Player: init YT.Player & sendHandshake()
User -> Hub: Enable "Camera Presence"
Hub -> Coach: startCameraPresence()
Coach -> Coach: getUserMedia({ video: 320x240 })
Coach -> CV: loadOpenCv() [async background]
Coach -> Hub: stream linked to live PiP monitor
note over Hub: PiP displays live video, tracking box,\nand ensures Chromium never throttles frames

== Presence Monitoring Loop (every 1.0s) ==
loop Continuous Study Monitoring
  Coach -> CV: analyzeFrame(hiddenCanvas)
  alt FaceDetector / OpenCV available
    CV -> CV: Detect face box & skin contours
  else Native Spatial Grid Fallback
    CV -> CV: 6x6 spatial cell density + optical flow motion
  end
  CV --> Coach: { isPresent, faceBox, gesture, motionIntensity }

  == Case 1: User Steps Away From Desk (2-3s Continuous Absence) ==
  alt isPresent == false (continuous absence ticks >= 3, i.e. 2.5-3.0s)
    Coach -> Coach: triggerAwayPause('AWAY_PRESENCE_LOST')
    Coach -> Player: pauseVideo() [direct + burst postMessage]
    Coach -> Hub: display Away Overlay + playChime()
    note over Hub: Video paused automatically.\nSpot preserved!
  end

  == Case 2: User Returns to Camera (1.5-2.0s Confirmed + 3s Rewind) ==
  alt isPresent == true (continuous return ticks >= 2)
    Coach -> Coach: rewindSeconds(3)
    Coach -> Player: seekTo(time - 3s)
    Coach -> Player: playVideo() [direct + postMessage]
    Coach -> Hub: dismiss Away Overlay & show "3s Rewound" toast
    note over User: Playback resumes automatically with 3s rewind!\nZero clicks needed.
  end

  == Case 3: User Performs Hand or Head Gesture (Personalized Motivation) ==
  alt gesture detected ('WAVE' | 'PALM' | 'NOD')
    Coach -> Hub: display glowing 1.5s countdown banner with [Cancel ✕]
    alt user cancels gesture
      User -> Hub: Click [Cancel ✕]
      Hub -> Coach: cancelPendingGesture()
    else 1.5s timer elapses confirmed
      Coach -> Coach: generatePersonalizedMotivation(gesture)
      note over Coach: Contextualized with User Name,\nCurrent DSA Topic, Streak, and Solved Stats
      Coach -> Coach: executeGestureAction(gesture)
      Coach -> Hub: display Floating Motivation Card & update Motivation Feed
      alt gesture == 'WAVE' (Hand Gesture)
        Coach -> Player: toggle play/pause
        Coach -> Hub: show 👋 Hand Wave motivation toast
      else gesture == 'PALM' (Hand Gesture)
        Coach -> Player: pauseVideo()
        Coach -> Hub: show ✋ Mindful Reflection motivation toast
      else gesture == 'NOD' (Head Gesture)
        Coach -> Coach: boost Active Learning Index (+5%)
        Coach -> Hub: show 🧠 Concept Internalized motivation toast
      end
    end
  end

  == Case 4: Video Paused -> Active DSA Recall Anchors ==
  alt isPaused == true
    Hub -> Hub: display Active DSA Recall Bar\n[⚠️ Edge Case] [📊 Complexity] [🧠 Invariant] [💻 Base Case]
    User -> Hub: Click concept anchor chip
    Hub -> Coach: notifyNoteRecorded()
    Hub -> Hub: append timestamped snippet to Notes
  end
end

== Teardown ==
Hub -> Coach: detachPlayer()
Coach -> Coach: stopCameraPresence() (release tracks, cancel timers, cleanup canvas)

@enduml
